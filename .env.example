# Copy to .env and adjust. Docker Compose reads this file automatically.

# Required: your GCP project id.
GOOGLE_CLOUD_PROJECT=

BIGQUERY_LOCATION=US

# Optional: dataset used for unqualified table names, e.g. `SELECT * FROM events`.
BIGQUERY_DEFAULT_DATASET=

# Cost + result guards. 1073741824 = 1 GiB per query.
BIGQUERY_MAX_BYTES_BILLED=1073741824
BIGQUERY_MAX_RESULTS=1000
BIGQUERY_USE_QUERY_CACHE=true

# true = only SELECT / WITH / EXPLAIN / DESCRIBE / SHOW may be submitted.
BIGQUERY_READ_ONLY=true

# Concurrency and timeout guards.
BIGQUERY_MAX_CONCURRENT_QUERIES=8
BIGQUERY_ACQUIRE_TIMEOUT=2s
BIGQUERY_QUERY_TIMEOUT=60s

# Retail demo dataset and domain limits.
RETAIL_DATASET=retail_demo
RETAIL_BUSINESS_ZONE=UTC
RETAIL_DEFAULT_PAGE_SIZE=50
RETAIL_MAX_PAGE_SIZE=200
RETAIL_DEMAND_WINDOW_DAYS=28
RETAIL_TARGET_COVER_DAYS=14
RETAIL_MAX_BYTES_BILLED=268435456
RETAIL_CURRENCY=USD
RETAIL_EVENT_MAX_FUTURE_SKEW=5m
RETAIL_EVENT_MAX_AGE=365d
RETAIL_RECONCILIATION_TOLERANCE=0
RETAIL_PROJECTION_ENABLED=false
RETAIL_PROJECTION_INTERVAL_MS=900000
RETAIL_PROJECTION_LOOKBACK_DAYS=7

# Micro-batched ledger sink. Retryable batch failures fail the whole batch; deterministic row
# failures use the bounded per-row fallback.
RETAIL_LEDGER_BATCH_ENABLED=true
RETAIL_LEDGER_BATCH_SIZE=100
RETAIL_LEDGER_BATCH_LINGER_MS=25
RETAIL_LEDGER_BATCH_MAX_PENDING=2000
RETAIL_LEDGER_BATCH_MAX_PENDING_BYTES=33554432
RETAIL_LEDGER_BATCH_WAIT_TIMEOUT=75s

# Response and controlled-DML guards.
MAX_RESPONSE_BYTES=5000000
BIGQUERY_WRITER_MAX_BYTES_BILLED=1073741824
BIGQUERY_WRITER_MAX_CONCURRENT_QUERIES=4
BIGQUERY_WRITER_ACQUIRE_TIMEOUT=2s

# Control-plane database (Postgres). Required at runtime.
FLYWAY_ENABLED=true
DATABASE_URL=jdbc:postgresql://localhost:5432/springtime
DATABASE_USERNAME=springtime
DATABASE_PASSWORD=springtime
DB_MAX_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=2000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_SOCKET_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5

# Supplier outbox. The local gateway is a demo adapter, not a real EDI/API integration.
SUPPLIER_GATEWAY=local
SUPPLIER_OUTBOX_ENABLED=true
SUPPLIER_OUTBOX_WORKER_ENABLED=true
SUPPLIER_OUTBOX_POLL_INTERVAL_MS=5000
SUPPLIER_OUTBOX_BATCH_SIZE=20
SUPPLIER_OUTBOX_MAX_ATTEMPTS=8
SUPPLIER_OUTBOX_INITIAL_DELAY=1s
SUPPLIER_OUTBOX_MULTIPLIER=2.0
SUPPLIER_OUTBOX_MAX_DELAY=5m
SUPPLIER_OUTBOX_JITTER=0.2

# Async messaging. Local demo uses the in-memory broker; production uses Pub/Sub.
MESSAGING_PUBSUB_ENABLED=false
MESSAGING_EVENTS_TOPIC=retail-events
MESSAGING_DLQ_TOPIC=retail-events-dlq
MESSAGING_SUBSCRIPTION=retail-events-worker
MESSAGING_CONSUMER_ENABLED=true
MESSAGING_LOCAL_CONSUMER_ENABLED=true
MESSAGING_LOCAL_CONSUMER_POLL_INTERVAL_MS=500
MESSAGING_MAX_IN_MEMORY_MESSAGES=1000
MESSAGING_RETRY_MAX_ATTEMPTS=5
MESSAGING_RETRY_INITIAL_DELAY=200ms
MESSAGING_RETRY_MULTIPLIER=2.0
MESSAGING_RETRY_MAX_DELAY=10s
MESSAGING_RETRY_JITTER=0.2

# OpenAPI/Swagger UI. Disable in shared environments.
SPRINGDOC_ENABLED=true

# Optional shared secret. Required unless OIDC is configured. `make env` generates one.
API_KEY=
# Previous key kept valid during rotation; `make key` moves the old key here.
API_KEY_PREVIOUS=

# Defensive HTTP/query limits.
MAX_REQUEST_BYTES=262144
MAX_SQL_LENGTH=100000
MAX_PARAMETER_VALUE_LENGTH=65536
MAX_PARAMETERS=100
ACCESS_LOG_ENABLED=true

# Pagination defaults and hard ceiling.
PAGE_DEFAULT_SIZE=100
PAGE_MAX_SIZE=1000

# Bounded async JSON log queue (lines). A full queue applies backpressure, never drops.
LOG_ASYNC_QUEUE_SIZE=1024

# OIDC/JWT resource server (production alternative to API_KEY).
# Use Spring's standard property names; Boot 4 builds the decoder from the issuer.
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://accounts.google.com
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=https://your-api.example.com
# OIDC_ROLES_CLAIM=roles
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_ALLOWED_SUBJECTS=1234567890
# ALLOW_INSECURE_OIDC=false   # true only for local http issuers
# ALLOW_API_KEY_IN_PRODUCTION=false  # production profile must use OIDC by default
# ADMIN_API_KEY=                    # optional separate operator/admin key

# Host port for the API (bound to 127.0.0.1 by default).
API_PORT=8080

# Local observability overlay (compose.observability.yaml). All ports bind to 127.0.0.1.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
TEMPO_PORT=3200
LOKI_PORT=3100
ALERTMANAGER_PORT=9093

# Load tests (see ops/loadtest). BASE_URL defaults to the Compose service name.
LOADTEST_STORE_ID=ST-001

# Structured tracing. Export is a no-op unless an OTLP/HTTP collector is running.
# Start one with: docker run --rm -p 4318:4318 otel/opentelemetry-collector:latest
TRACING_ENABLED=true
TRACING_SAMPLING_PROBABILITY=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Host directory containing application_default_credentials.json.
# Defaults to ${HOME}/.config/gcloud when unset.
# GCLOUD_CONFIG_DIR=/Users/you/.config/gcloud
